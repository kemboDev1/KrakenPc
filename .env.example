# Copy this file to .env. Never commit .env.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_URL=
TRUST_PROXY=0

# Rotate the Telegram bot token before configuring it here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Set strong, unique values before using admin or customer checkout publicly.
ADMIN_PASSWORD=
SESSION_SECRET=
